# Website builds use same-origin paths, which the deployment reverse proxy routes
# to the individual services. The standalone Tauri app resolves these paths
# against a single mono backend (dataset-store serves /auth/, /api/ and /ds/).
#
# Tauri backend selection:
#   default                          -> https://beta.edge-ml.org
#   VITE_TAURI_USE_LOCAL_BACKEND=1   -> http://localhost:3004 (locally running backend)
#   VITE_TAURI_BACKEND_URL=<url>     -> explicit override, wins over everything
# At runtime a packaged build can also be switched via
# localStorage.setItem("tauri-backend", "local").
#
# VITE_TAURI_BACKEND_URL=https://beta.edge-ml.org
VITE_API_BASE_URL=/api/
VITE_AUTH_BASE_URL=/auth/
VITE_ML_BASE_URL=/ml/
VITE_DS_BASE_URL=/ds/
