# Website builds use same-origin paths, which the deployment reverse proxy routes
# to the individual services. The standalone Tauri app resolves these paths
# against this backend because it does not have the website's reverse proxy.
VITE_TAURI_BACKEND_URL=https://beta.edge-ml.org
VITE_API_BASE_URL=/api/
VITE_AUTH_BASE_URL=/auth/
VITE_ML_BASE_URL=/ml/
VITE_DS_BASE_URL=/ds/
